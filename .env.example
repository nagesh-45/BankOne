# Copy to .env for local docker-compose (do not commit .env)
POSTGRES_DB=bankone
POSTGRES_USER=bankone_user
POSTGRES_PASSWORD=change-me-strong-password

# Backend
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/bankone
SPRING_DATASOURCE_USERNAME=bankone_user
SPRING_DATASOURCE_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION=3600000
PORT=8080
# Comma-separated CORS origin patterns (supports *)
APP_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Frontend build-time API URL (used by Docker web image)
API_BASE_URL=http://localhost:8080

# --- Kafka + mail notifications ---
# Local (Docker): kafka on :9092, Mailpit SMTP :1025 / UI :8025
APP_KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_NOTIFICATION_TOPIC=bankone.notifications
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
MAIL_TRANSPORT=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=noreply@bankone.local
MAIL_NOTIFY_TO=ops@bankone.local

# Render + Aiven Kafka + Twilio SendGrid HTTP (SMTP is blocked on Render):
# APP_KAFKA_ENABLED=true
# KAFKA_BOOTSTRAP_SERVERS=name.aivencloud.com:12345
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="avnadmin" password="...";
# KAFKA_SSL_TRUSTSTORE_TYPE=PEM
# KAFKA_CA_CERT=-----BEGIN CERTIFICATE-----....-----END CERTIFICATE-----
# KAFKA_NOTIFICATION_TOPIC=bankone.notifications
# MAIL_TRANSPORT=sendgrid
# MAIL_PASSWORD=SG.xxxx
# MAIL_FROM=verified-sender@gmail.com
# MAIL_NOTIFY_TO=you@gmail.com
# Until Kafka exists: APP_KAFKA_ENABLED=false
